# Local login. Change all three secrets before first use.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME
JWT_SECRET=CHANGE-ME
POLICY_HMAC_SECRET=CHANGE-ME

POSTGRES_DB=leadintel
POSTGRES_USER=leadintel
POSTGRES_PASSWORD=CHANGE-ME
DATABASE_URL=postgresql+psycopg://leadintel:CHANGE-ME@db:5432/leadintel
# REDIS_URL must embed the same password as REDIS_PASSWORD.
REDIS_PASSWORD=CHANGE-ME
REDIS_URL=redis://:CHANGE-ME@redis:6379/0
DATA_DIR=/data
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Public hosting (docker-compose.prod.yml): uncomment and set all four.
# ENVIRONMENT=production
# DOMAIN=leads.example.com
# ACME_EMAIL=you@example.com
# CORS_ORIGINS=https://leads.example.com

# Optional integrations. Leave blank to keep disabled.
GOOGLE_MAPS_API_KEY=
HUNTER_API_KEY=
EMAIL_VERIFICATION_API_KEY=

# Configure one Overture source. RELEASE is the release folder name without a trailing slash.
OVERTURE_RELEASE=
# Example: s3://overturemaps-us-west-2/release/RELEASE/theme=places
OVERTURE_PARQUET_URI=
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
# Paid AI/web research is disabled until this is set above zero.
AI_RESEARCH_MAX_BUDGET_CENTS=0
# Maximum built-in web-search calls in one bounded AI response.
AI_RESEARCH_MAX_TOOL_CALLS=2

# Research-first automation. Review source policy/configuration before enabling.
AUTO_RESEARCH_ENABLED=false
AUTO_RESEARCH_BATCH_SIZE=25
AUTO_RESEARCH_STALE_DAYS=30
# Enables implemented SAM.gov, USAspending, SEC EDGAR, and GLEIF adapters.
FREE_API_RESEARCH_ENABLED=false
SAM_GOV_API_KEY=
# SEC requires a descriptive User-Agent with organization and contact email.
SEC_USER_AGENT=
MAX_WEBSITE_PAGES=12
WEBSITE_TIMEOUT_SECONDS=15

# Google Calendar uses this application's OAuth credentials, not a Codex connector.
# Generate a dedicated encryption key; do not reuse JWT_SECRET or POLICY_HMAC_SECRET.
CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_ID=primary
CALENDAR_SYNC_INTERVAL_SECONDS=300
PUBLIC_APP_URL=http://localhost:8080
